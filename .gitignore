# ============================================================
# 《萌宠拼拼乐》仓库忽略规则
# ============================================================

# ---------- 1. 废弃 / 历史资源（体积过大，不入库）----------
# 备份:       约 433 MB（旧版 UI、废弃切片图）
# 不明用途:   约  28 MB（渲染检查图等中间产物）
备份/
不明用途/
# 远程包备份（从 candy.aidertech.cn 下载的 remote bundle 快照）
remote-backup-*/
# 临时调试脚本（贴控制台用）
debug-touch.js

# ---------- 2. Cocos Creator 生成物（可重建，不入库）----------
library/
temp/
local/
build/
profiles/
native/
.creator/
**/_tmp_check/

# ---------- 3. 依赖 ----------
node_modules/

# ---------- 4. 编辑器 / IDE ----------
.vscode/
.idea/
.codebuddy/

# ---------- 5. 系统与日志 ----------
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp
